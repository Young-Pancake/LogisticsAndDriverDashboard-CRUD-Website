
<!DOCTYPE html>
<html>
<head>
  <title>Driver-login</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      margin: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    .driver-container {
      width: 300px;
      padding: 20px;
      background-color: #fff;
      border-radius: 5px;
      box-shadow: 0px 2px 10px rgba(0, 0, 0, 0.1);
    }
    .driver-container h1 {
      color: #333;
      text-align: center;
    }
    .driver-container input[type="text"],
    .driver-container input[type="password"],
    .driver-container button {
      width: 100%;
      padding: 10px;
      margin-bottom: 10px;
      border-radius: 3px;
      border: 1px solid #ccc;
      box-sizing: border-box;
    }
    .driver-container input[type="text"]:focus,
    .driver-container input[type="password"]:focus {
      outline: none;
      border-color: #007bff;
      box-shadow: 0px 0px 5px rgba(0, 123, 255, 0.5);
    }
    .driver-container button {
      background-color: #007bff;
      color: #fff;
      font-size: 16px;
      cursor: pointer;
    }
    .driver-container button:hover {
      background-color: #0056b3;
    }
    .driver-container p {
      margin-top: 10px;
      font-size: 14px;
      text-align: center;
    }
    .driver-container a {
      color: #007bff;
      text-decoration: none;
    }
    .driver-container a:hover {
      text-decoration: underline;
    }
    table, th, td {
     border: 1px solid black;
    }
  </style>
</head>
<body>
</body>
</html>
